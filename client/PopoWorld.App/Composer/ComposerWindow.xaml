<Window x:Class="PopoWorld.App.Composer.ComposerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="말하기"
        Width="340" Height="150"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="BodyBox"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 FontSize="13"
                 TextChanged="BodyBox_TextChanged"
                 PreviewKeyDown="BodyBox_PreviewKeyDown" />
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Padding="14,4" Click="SendButton_Click" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Text="Enter 보내기 · Shift+Enter 줄바꿈" />
            <TextBlock x:Name="CounterText" VerticalAlignment="Center" Margin="8,0" Foreground="Gray" FontSize="11" Text="0/200" />
        </DockPanel>
    </Grid>
</Window>
