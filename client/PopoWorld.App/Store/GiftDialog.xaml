<Window x:Class="PopoWorld.App.Store.GiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포포 선물"
        Width="300" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <StackPanel Margin="16">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Margin="0,0,0,10" />
        <TextBlock x:Name="InfoText" Foreground="Gray" FontSize="11" Margin="0,0,0,10" />
        <TextBlock Text="보낼 포포" />
        <DockPanel Margin="0,2,0,10">
            <Button x:Name="MinusButton" DockPanel.Dock="Left" Content="−" Width="28" Click="MinusButton_Click" />
            <Button x:Name="PlusButton" DockPanel.Dock="Right" Content="+" Width="28" Click="PlusButton_Click" />
            <TextBox x:Name="AmountBox" TextAlignment="Center" Margin="4,0" TextChanged="AmountBox_TextChanged" />
        </DockPanel>
        <TextBlock Text="메모 (20자까지)" />
        <TextBox x:Name="MemoBox" MaxLength="20" Margin="0,2,0,10" TextChanged="AmountBox_TextChanged" />
        <TextBlock x:Name="ErrorText" Foreground="Crimson" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Button x:Name="SendButton" Content="보내기" Padding="0,6" Click="SendButton_Click" IsDefault="True" />
    </StackPanel>
</Window>
