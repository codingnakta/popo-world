<Window x:Class="PopoWorld.App.Login.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="포포월드 로그인"
        Width="320" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <StackPanel Margin="20">
        <TextBlock Text="포포월드" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
        <TextBlock Text="이메일" />
        <TextBox x:Name="EmailBox" Margin="0,2,0,10" />
        <TextBlock Text="비밀번호" />
        <PasswordBox x:Name="PasswordBox" Margin="0,2,0,10" KeyDown="PasswordBox_KeyDown" />
        <TextBlock x:Name="ErrorText" Foreground="Crimson" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8" />
        <Button x:Name="LoginButton" Content="로그인" Padding="0,6" Click="LoginButton_Click" IsDefault="True" />
        <TextBlock Text="계정은 관리자가 만들어 전달해요." FontSize="11" Foreground="Gray" Margin="0,10,0,0" />
    </StackPanel>
</Window>
